# ── zcode2api 配置（两套 compose 共用本文件）─────────────────────────
# docker compose 会自动读取同目录的 .env，并用它做变量替换。
# 最简用法：只填第一项 ZCODE_SEED_ACCOUNTS，其余保持默认。
#
#   cp .env.example .env

# ── 必填：Start Plan 账号 ────────────────────────────────────────────
# 格式：bigmodel:<zcodejwttoken>
#
# 取 JWT（在有 ZCode 桌面端的机器上跑）：
#   node launcher/extract-zcode-jwt.cjs       -> 生成 zcode-jwt.txt
# 把 zcode-jwt.txt 的内容整段粘到下面引号内。
#
# 留空则容器里没有账号，需自行登录后台（见下方端口）添加；
# 或把已有的 data/accounts.db 直接挂/拷进去。
#
# ⚠️ 等同密码。本文件已在 .gitignore 里，别提交、别外传。
ZCODE_SEED_ACCOUNTS=""

# ── 反代模式 ────────────────────────────────────────────────────────
# start-plan（默认）：反代 ZCode Start Plan 额度，普通人用这个
# coding-plan      ：上游原版行为（Coding Plan 反代）
ZCODE_PLAN_MODE=start-plan

# ── 端口 ────────────────────────────────────────────────────────────
# ZCODE_PORT ：容器内监听端口（应用监听这个），一般保持 3000
# SERVER_PORT：宿主机端口。不设的话：基础版用 3000，1panel 版用 12158
#
# 例：想让宿主机 12345 → 容器 3000，就把下面 SERVER_PORT 那行取消注释并改成 12345
ZCODE_PORT=3000
# SERVER_PORT=12345

# ── 后台管理密码 ────────────────────────────────────────────────────
# 首次启动写入数据库，之后以数据库为准
ZCODE_ADMIN_KEY=zcode

# ── 以下一般不用改 ──────────────────────────────────────────────────
# 被上游 429 限流后的冷却秒数
ZCODE_COOLING_SECONDS=300
# 额度监控对新套餐不生效，保持 0 关闭
ZCODE_QUOTA_REFRESH_INTERVAL=0
# 容器时区
TZ=Asia/Shanghai

# ────────────────────────────────────────────────────────────────────
# coding-plan 模式专用（用 start-plan 的话不用管）
# ────────────────────────────────────────────────────────────────────
# 官方端点覆盖：
# ZAI_UPSTREAM_URL=https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
# ZAI_FALLBACK_URL=https://api.z.ai/api/anthropic/v1/messages
# BIGMODEL_UPSTREAM_URL=https://open.bigmodel.cn/api/anthropic/v1/messages
# 阿里云无痕验证求解（无浏览器：Node + jsdom，需 captcha_node/）
# ZCODE_NODE_PATH=node
# ZCODE_CAPTCHA_TIMEOUT=40
# ZCODE_CAPTCHA_RETRIES=4
# CAPTCHA_CACHE_TTL=45000
# CAPTCHA_CONFIG_CACHE_TTL=600000
